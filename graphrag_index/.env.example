# Copy to graphrag_index/.env and fill in. .env is gitignored — never commit your key.
# Pick ONE provider block. Check the provider's current free-tier limits and set RPM/TPM below them.

# --- Groq (https://console.groq.com/keys) ---
GRAPHRAG_API_BASE=https://api.groq.com/openai/v1
GRAPHRAG_LLM_MODEL=qwen/qwen3-32b
GRAPHRAG_SUMMARY_MODEL=qwen/qwen3-32b
GRAPHRAG_API_KEY=
GRAPHRAG_RPM=25
GRAPHRAG_TPM=5000

# --- Google Gemini (https://aistudio.google.com/apikey) ---
# GRAPHRAG_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# GRAPHRAG_LLM_MODEL=gemini-3.5-flash          # Lite garbles the <|> delimiters
# GRAPHRAG_SUMMARY_MODEL=gemini-3.5-flash-lite
# GRAPHRAG_API_KEY=
# GRAPHRAG_RPM=8
# GRAPHRAG_TPM=200000
